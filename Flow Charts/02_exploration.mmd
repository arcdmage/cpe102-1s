%%{init: {"flowchart": {"nodeSpacing": 30, "rankSpacing": 45}}}%%
flowchart LR
    classDef step fill:#e0e7ff,stroke:#6366f1,color:#312e81
    classDef good fill:#ccfbf1,stroke:#0d9488,color:#134e4a
    classDef bad fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
    classDef sub fill:#fef3c7,stroke:#d97706,color:#78350f

    subgraph LEGEND["Legend"]
        direction LR
        L1["Normal step"]:::step
        L2["New evidence found"]:::good
        L4["Detailed in another chart"]:::sub
    end

    START(["exploreLoop() starts<br/>px = 30, py = 10"]):::step --> DRAW["drawScreen(px, py, msg)"]:::step
    DRAW --> RK["key = tolower(readKey())"]:::step
    RK --> K{"Which key?"}:::step

    K -- "W A S D" --> TGT["Compute nx, ny"]:::step
    TGT --> CM{"canMove(nx, ny)?<br/>floor tile and<br/>no suspect there"}:::step
    CM -- "Yes" --> MV["px, py = nx, ny"]:::step
    MV --> DRAW
    CM -- "No" --> BLK["msg: Something is in the way"]:::step
    BLK --> DRAW
    K -- "Other key" --> INV["msg: Invalid key"]:::step
    INV --> DRAW

    K -- "C" --> CFM{"Case File menu<br/>showCaseFile()"}:::step
    CFM -- "1 Overview and crime scene" --> CF1["Show overview"]:::step
    CFM -- "2 Timeline" --> CF2["Show timeline"]:::step
    CFM -- "3 Evidence log" --> CF3["List found evidence<br/>(count out of 8)"]:::step
    CFM -- "4 Persons of interest" --> CF4["Pick a suspect:<br/>profile, statement, status"]:::step
    CF1 --> CFM
    CF2 --> CFM
    CF3 --> CFM
    CF4 --> CFM
    CFM -- "0 Close" --> DRAW
    K -- "N" --> NT["showNotes()<br/>5 notes per page"]:::step
    NT --> DRAW

    K -- "E" --> ES{"Suspect within 1 tile?"}:::step
    ES -- "Yes" --> INT[["interview(i)<br/>see Chart 3"]]:::sub
    INT --> DRAW
    ES -- "No" --> SYM{"Which symbol<br/>is within 1 tile?"}:::step
    SYM -- "None" --> NONE["msg: Nothing nearby"]:::step
    NONE --> DRAW
    SYM -- "$ floor safe" --> SAFE["examineSafe()<br/>description only"]:::step
    SAFE --> DRAW

    SYM -- "Study Room desk" --> DK{"Ink evidence<br/>already found?"}:::step
    DK -- "Yes" --> DK1["Show: already examined"]:::step
    DK -- "No" --> DK2{"Gideon's light topic done<br/>OR cufflink found?"}:::step
    DK2 -- "Yes" --> DK3["Ink-Stained Spare Key found<br/>add evidence and note"]:::good
    DK2 -- "No" --> DK4["Show hint only"]:::step
    DK1 --> DRAW
    DK3 --> DRAW
    DK4 --> DRAW

    SYM -- "% trash can (Staff Quarters)" --> TR{"Catalog evidence<br/>already found?"}:::step
    TR -- "No" --> TR1["Handbag Catalog Pages found<br/>add evidence and note"]:::good
    TR -- "Yes" --> TR2["Show: already found"]:::step
    TR1 --> DRAW
    TR2 --> DRAW

    SYM -- "^ balcony door" --> SO{"Soil evidence<br/>already found?"}:::step
    SO -- "No" --> SO1["Garden Soil Traces found<br/>add evidence and note"]:::good
    SO -- "Yes" --> SO2["Show: already found"]:::step
    SO1 --> DRAW
    SO2 --> DRAW

    K -- "X" --> DED[["deduction()<br/>see Chart 4"]]:::sub
    DED -- "false (chose 0)" --> NR["msg: Not ready to accuse"]:::step
    NR --> DRAW
    DED -- "true (case ends)" --> END1(["return 1<br/>back to playGame()"]):::step
    K -- "Q" --> END0(["return 0<br/>back to main menu"]):::step
